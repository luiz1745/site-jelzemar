rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {
    // TROQUE pelo e-mail do dono (o mesmo de firebase-config.js)
    function admin() {
      return request.auth != null && request.auth.token.email_verified == true
        && request.auth.token.email in ['COLE_SEU_EMAIL@gmail.com'];
    }
    match /orders/{oid} {
      allow read: if request.auth != null && (resource.data.uid == request.auth.uid || admin());
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid && request.resource.data.status == 0;
      allow update: if request.auth != null && (admin() || (
        resource.data.uid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','lastMsg','updatedAt','unreadAdmin','unreadUser'])
        && (request.resource.data.status == resource.data.status || (resource.data.status == 0 && request.resource.data.status == 1))));
      allow delete: if false;
      match /messages/{mid} {
        allow read: if request.auth != null && (admin() || get(/databases/$(db)/documents/orders/$(oid)).data.uid == request.auth.uid);
        allow create: if request.auth != null && request.resource.data.text.size() < 2000
          && (!('img' in request.resource.data) || request.resource.data.img.size() < 700000)
          && (admin() || (get(/databases/$(db)/documents/orders/$(oid)).data.uid == request.auth.uid && request.resource.data.from in ['buyer','sys']));
        allow update, delete: if false;
      }
    }
  }
}
